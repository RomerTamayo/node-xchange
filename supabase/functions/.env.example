# Public URL of this node's `nx` function (must fit in 64 bytes: it is published on-chain)
NX_NODE_URL=http://127.0.0.1:54321/functions/v1/nx
NX_NODE_NAME=NodeXchange local
# Operator address: receives fees and arbitrates escrow disputes
NX_OPERATOR=GBDUJIASCL2T34EWQJQY6E5AA7HEFFDQQI22D7YPJVDYUW35PRMRUWQT
# Fee on direct transfers, in basis points (50 = 0.5%). Escrow deals are charged by the contract.
NX_TRANSFER_FEE_BPS=0
NX_HORIZON_URL=https://horizon-testnet.stellar.org
